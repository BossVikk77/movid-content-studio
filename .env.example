# Movid Academy — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file, rename it to .env, and fill in your values.
# NEVER commit .env to GitHub — it is listed in .gitignore.
#
# These values are added as GitHub Secrets and injected into
# the HTML at build time by the GitHub Actions workflow.
# ─────────────────────────────────────────────────────────

# Groq API Key — free at https://console.groq.com/keys
GROQ_KEY=gsk_your_key_here

# HCTI (HTML/CSS to Image) credentials — free at https://htmlcsstoimage.com
# Free plan: 50 images/month
HCTI_UID=your_user_id_here
HCTI_KEY=your_api_key_here
